# ===========================================================
#  .env — Variables de entorno (desarrollo local)
# ===========================================================

# ─── Base de datos local ─────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=retos_fotograficos_expres
DB_USER=postgres
DB_PASSWORD=password

# ─── JWT ─────────────────────────────────────────────────────
# Puedes poner cualquier texto largo y aleatorio aquí
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES=7d

# ─── Cloudinary ──────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Servidor ────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

PGCLIENTENCODING=UTF8